#!/bin/zsh
set -u

file="${1:-}"
[[ -n "$file" ]] || exit 0

repo="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
cd "$repo" || exit 0

[[ "$file" == "$repo"/* ]] || exit 0

if git diff --quiet -- "$file" && git diff --cached --quiet -- "$file"; then
  exit 0
fi

cache="${TMPDIR:-/tmp/}codex-snoop"
mkdir -p "$cache" || exit 0

key="$(printf '%s|%s' "$repo" "$file" | shasum -a 256 | awk '{ print $1 }')"
stamp="$cache/$key.stamp"
lock="$cache/$key.lock"
out="$cache/$key.out"
context_file="$cache/$key.context"

now="$(date +%s)"
last="$(cat "$stamp" 2>/dev/null || echo 0)"
min_seconds="${CODEX_SNOOP_MIN_SECONDS:-180}"

if (( now - last < min_seconds )); then
  exit 0
fi

mkdir "$lock" 2>/dev/null || exit 0
trap 'rmdir "$lock" 2>/dev/null' EXIT
printf '%s\n' "$now" > "$stamp"

{
  printf 'Repo: %s\n' "$repo"
  printf 'Focused file: %s\n\n' "${file#$repo/}"

  printf 'Git status:\n'
  git status --short

  printf '\nDiff stat:\n'
  git diff --stat

  if command -v sqlite3 >/dev/null 2>&1 && [[ -f "$HOME/.codex/state_5.sqlite" ]]; then
    printf '\nRecent Codex threads for this repo:\n'
    sqlite3 "$HOME/.codex/state_5.sqlite" \
      "select datetime(updated_at_ms/1000,'unixepoch') || ' | ' || title || ' | ' || rollout_path from threads where cwd='$repo' order by updated_at_ms desc limit 5;" \
      2>/dev/null
  fi

  if command -v opencode >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
    printf '\nRecent opencode sessions for this repo:\n'
    opencode session list -n 20 --format json 2>/dev/null \
      | jq -r --arg repo "$repo" '.[] | select(.directory == $repo) | "\(.updated) | \(.title) | \(.id)"' 2>/dev/null
  fi
} > "$context_file"

context="$(head -80 "$context_file")"

prompt="You are a quiet on-save reviewer for a Neovim user. Review the current uncommitted Git changes with special attention to ${file#$repo/}.

Use the repository, nearby code, existing uncommitted changes, and this local context as signal:

$context

Only report concrete correctness, safety, data-loss, build, test, or maintainability issues that are worth interrupting the user for. If there are no such issues, say exactly: NO_INTERRUPT."

review="$(codex review --uncommitted "$prompt" 2>&1)"
status=$?
printf '%s\n' "$review" > "$out"

if (( status != 0 )); then
  osascript - "Codex review failed" "On-save review failed for ${file:t}. See $out." <<'APPLESCRIPT' >/dev/null 2>&1
on run argv
  display notification item 2 of argv with title item 1 of argv
end run
APPLESCRIPT
  exit 0
fi

if printf '%s\n' "$review" | grep -Eiq '(^|[^A-Z])NO_INTERRUPT([^A-Z]|$)|no issues|no findings'; then
  exit 0
fi

body="$(printf '%s\n' "$review" | sed -e 's/\x1b\[[0-9;]*m//g' | awk 'NF { print }' | head -6 | tr '\n' ' ')"
[[ -n "$body" ]] || body="Codex found something worth checking in ${file:t}."

osascript - "Codex saw a possible bad edit" "$body" <<'APPLESCRIPT' >/dev/null 2>&1
on run argv
  display notification item 2 of argv with title item 1 of argv
end run
APPLESCRIPT
